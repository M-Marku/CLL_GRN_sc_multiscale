# ── Gap heatmap function -------------------------------------------------------
plot_gap_heatmap <- function(mat,
top_rows,
bottom_rows,
annotation_col,
ann_colors,
gap_label   = "···",
palette_n   = 100,
body_top    = 0.90,
body_bottom = 0.08,
rect_x      = 0.50,
rect_width  = 0.68,
label_x     = 0.755,
...) {
stopifnot(all(top_rows    %in% rownames(mat)))
stopifnot(all(bottom_rows %in% rownames(mat)))
top_mat    <- mat[top_rows,    , drop = FALSE]
bottom_mat <- mat[bottom_rows, , drop = FALSE]
gap_mat           <- matrix(colMeans(mat), nrow = 1, ncol = ncol(mat))
rownames(gap_mat) <- ".gap."
colnames(gap_mat) <- colnames(mat)
display_mat <- rbind(top_mat, gap_mat, bottom_mat)
n_total     <- nrow(display_mat)
n_top       <- nrow(top_mat)
row_labels            <- rownames(display_mat)
row_labels[n_top + 1] <- gap_label
names(row_labels)     <- rownames(display_mat)
pal <- viridis(palette_n, option = "D")
p <- pheatmap(
display_mat,
color              = pal,
labels_row         = row_labels,
cluster_rows       = FALSE,
gaps_row           = c(n_top, n_top + 1),
annotation_col     = annotation_col,
annotation_colors  = ann_colors,
show_colnames      = FALSE,
...
)
body_height <- body_top - body_bottom
row_h       <- body_height / n_total
gap_top_y   <- body_top    - n_top * row_h
gap_bot_y   <- gap_top_y   - row_h
gap_mid_y   <- (gap_top_y  + gap_bot_y) / 2
pushViewport(viewport(
x = unit(0, "npc"), y = unit(0, "npc"),
width = unit(1, "npc"), height = unit(1, "npc"),
just = c("left", "bottom")
))
grid.rect(
x      = unit(rect_x,     "npc"),
y      = unit(gap_mid_y,  "npc"),
width  = unit(rect_width, "npc"),
height = unit(row_h + 0.004, "npc"),
gp     = gpar(fill = "white", col = NA)
)
grid.text(
label = gap_label,
x     = unit(label_x, "npc"),
y     = unit(gap_mid_y, "npc"),
gp    = gpar(col = "grey50", fontsize = 10, fontface = "bold")
)
popViewport()
invisible(p)
}
# ── Define which TFs to show in the gap heatmap --------------------------------
top_show <- c("TAF7", "MSI2", "ENO1", "IRF8", "SPIB", "YBX1", "HMGB1",
"ARID5B", "ILF2", "ZBTB7A", "KLF6", "ZNF160", "CREB3L2")
bot_show <- c("ETV5", "JUN", "JUND", "DDIT3", "ATF4", "JUNB", "TCF4",
"MEF2C", "BCL11A", "ATF6B", "FOXP1", "IRF1", "STAT1")
plot_gap_heatmap(
mat            = t(filtered_mat),
top_rows       = top_show,
bottom_rows    = bot_show,
annotation_col = annotation_col,
ann_colors     = ann_colors,
gap_label      = "···",
fontsize       = 10,
main           = paste("Top", top_n, "TFs regulon activity")
)
# ── t-SNE on regulon activity ---------------------------------------------------
aucMat     <- AUCell_df[, apply(AUCell_df, 2, sd) > 0]
auc_scaled <- scale(aucMat)
pca        <- prcomp(auc_scaled, center = FALSE, scale. = FALSE)
n_pcs      <- 30
set.seed(100)
tsne <- Rtsne(pca$x[, 1:n_pcs], perplexity = 30, theta = 0.5, verbose = TRUE)
tsne_df <- data.frame(
tSNE1 = tsne$Y[, 1],
tSNE2 = tsne$Y[, 2],
Time  = D_values,
Cell  = rownames(AUCell_df)
)
tsne_time <- ggplot(tsne_df, aes(tSNE1, tSNE2, color = Time)) +
geom_point(size = 0.8, alpha = 0.7) +
theme_classic() +
theme(legend.title = element_text(size = 14),
legend.text  = element_text(size = 12)) +
labs(title = "Regulon-based t-SNE", color = "Time point") +
scale_color_manual(values = TIMEPOINT_COLORS)
tsne_time
regulon_names <- c("ARID5B", "ATF4", "DDIT3", "ETV5", "FOS",
"HMGB1", "TAF7", "JUN", "JUNB", "JUND")
plot_tf_tsne_grid <- function(tsne_df, aucMat, tfs,
ncol = 5, point_size = 0.7, show_legend = TRUE) {
plots <- list()
for (tf in tfs) {
if (!tf %in% colnames(aucMat)) { warning(paste(tf, "not found, skipping")); next }
tsne_df$activity <- aucMat[tsne_df$Cell, tf]
p <- ggplot(tsne_df, aes(tSNE1, tSNE2, color = activity)) +
geom_point(size = point_size) +
scale_color_viridis_c(option = "D") +
theme_classic() +
labs(title = tf, color = "Regulon activity") +
theme(plot.title      = element_text(hjust = 0.5, size = 14),
legend.text     = element_text(size = 12),
legend.position = ifelse(show_legend, "right", "none"))
plots[[tf]] <- p
}
wrap_plots(plots, ncol = ncol)
}
plots_arranged <- plot_tf_tsne_grid(tsne_df, aucMat, regulon_names)
plots_arranged
library(dplyr)
library(tidyverse)
library(ggplot2)
library(ggrepel)
# ── Load AUCell + assign timepoints -------------------------------------------
AUCell_df <- read.csv(AUCELL_CSV, header = TRUE, row.names = 1, sep = "\t")
AUCell_df <- clean_aucell_colnames(AUCell_df)
D_values  <- extract_timepoint(rownames(AUCell_df))
# ── Wilcoxon test: M27 vs. M0+M3 for every regulon -----------------------------
df_long <- AUCell_df %>%
as.data.frame() %>%
mutate(Cell = rownames(.), Group = D_values[Cell]) %>%
pivot_longer(cols = -c(Cell, Group), names_to = "Regulon", values_to = "Activity")
wilcox_results <- df_long %>%
group_by(Regulon) %>%
summarise(
p_value = wilcox.test(
Activity[Group == "M27"],
Activity[Group %in% c("M0", "M3")]
)$p.value,
direction = median(Activity[Group == "M27"]) -
median(Activity[Group %in% c("M0", "M3")]),
.groups = "drop"
) %>%
mutate(FDR = p.adjust(p_value, method = "fdr")) %>%
arrange(FDR)
sig_up_M27   <- wilcox_results %>% filter(FDR < 0.05 & direction > 0 & p_value < 0.05)
sig_down_M27 <- wilcox_results %>% filter(FDR < 0.05 & direction < 0 & p_value < 0.05)
View(sig_up_M27)
# ── RSS: M27 vs. Other (2-group), using the manual reimplementation ------------
group_2 <- factor(ifelse(D_values == "M27", "M27", "Other"), levels = c("M27", "Other"))
names(group_2) <- names(D_values)
rss_2groups <- calc_rss_manual(as.matrix(AUCell_df), group_2)
rss_df <- data.frame(
regulon = rownames(rss_2groups),
RSS     = rss_2groups[, "M27"]
) %>%
arrange(desc(RSS)) %>%
mutate(rank = row_number())
View(rss_df)
RSS_plot <- ggplot(rss_df, aes(x = rank, y = RSS)) +
geom_point(color = "steelblue", size = 2) +
geom_point(data = subset(rss_df, regulon %in% tfs_to_label),
color = "red", size = 3) +
geom_text_repel(
data = subset(rss_df, regulon %in% tfs_to_label),
aes(label = regulon),
color = "red", size = 4, nudge_x = 0.5, nudge_y = 0.01,
max.overlaps = Inf, box.padding = 0.4, force = 2,
segment.color = "grey50", direction = "y", seed = 42
) +
labs(x = "Regulon", y = "RSS", title = "RSS score, M27") +
theme_bw(base_size = 14) +
theme(panel.grid = element_blank(), axis.text.x = element_blank())
# Label the TFs found significantly up-regulated in M27 by the Wilcoxon test
tfs_to_label <- sig_up_M27$Regulon
RSS_plot <- ggplot(rss_df, aes(x = rank, y = RSS)) +
geom_point(color = "steelblue", size = 2) +
geom_point(data = subset(rss_df, regulon %in% tfs_to_label),
color = "red", size = 3) +
geom_text_repel(
data = subset(rss_df, regulon %in% tfs_to_label),
aes(label = regulon),
color = "red", size = 4, nudge_x = 0.5, nudge_y = 0.01,
max.overlaps = Inf, box.padding = 0.4, force = 2,
segment.color = "grey50", direction = "y", seed = 42
) +
labs(x = "Regulon", y = "RSS", title = "RSS score, M27") +
theme_bw(base_size = 14) +
theme(panel.grid = element_blank(), axis.text.x = element_blank())
RSS_plot
library(fgsea)
if (!require("BiocManager", quietly = TRUE))
install.packages("BiocManager")
BiocManager::install("fgsea")
library(fgsea)
library(msigdbr)
ranked_tfs <- setNames(rss_df$RSS, rss_df$regulon)
ranked_tfs <- sort(ranked_tfs, decreasing = TRUE)
# Combine Reactome + KEGG + GO:BP to mirror the original gprof_sources choice
msig_sets <- bind_rows(
msigdbr(species = "Homo sapiens", category = "C2", subcategory = "CP:REACTOME"),
msigdbr(species = "Homo sapiens", category = "C2", subcategory = "CP:KEGG"),
msigdbr(species = "Homo sapiens", category = "C5", subcategory = "GO:BP")
)
msigdbr_collections()
# Combine Reactome + KEGG + GO:BP to mirror the original gprof_sources choice
msig_sets <- bind_rows(
msigdbr(species = "Homo sapiens", category = "C2", subcategory = "CP:REACTOME"),
msigdbr(species = "Homo sapiens", category = "C5", subcategory = "GO:BP")
)
pathway_list <- split(msig_sets$gene_symbol, msig_sets$gs_name)
set.seed(42)
gsea_res <- fgsea(
pathways = pathway_list,
stats    = ranked_tfs,
minSize  = 3,     # small on purpose — ranking universe is ~568 TFs, not the whole transcriptome
maxSize  = 500,
eps      = 0
)
gsea_res <- gsea_res[order(gsea_res$padj), ]
View(gsea_res)
View(gsea_res)
gsea_res <- fgsea(
pathways = pathway_list,
stats    = ranked_tfs,
minSize  = 10,     # small on purpose — ranking universe is ~568 TFs, not the whole transcriptome
maxSize  = 500,
eps      = 0
)
gsea_res <- gsea_res[order(gsea_res$padj), ]
View(gsea_res)
library(tidyverse)
library(pheatmap)
library(viridis)
fate_probs <- read.csv(FATE_PROBS_CSV, header = TRUE, row.names = 1)
colnames(fate_probs) <- c("M3 lineage", "M27 lineage")
common_cells <- intersect(rownames(AUCell_df), rownames(fate_probs))
fate_probs   <- fate_probs[common_cells, ]
AUCell_df    <- AUCell_df[common_cells, ]
# ── Spearman correlation: regulon activity vs. fate probability ----------------
cor_matrix <- matrix(
NA, nrow = ncol(AUCell_df), ncol = ncol(fate_probs),
dimnames = list(colnames(AUCell_df), colnames(fate_probs))
)
pval_matrix <- cor_matrix
for (fate in colnames(fate_probs)) {
for (reg in colnames(AUCell_df)) {
res <- cor.test(fate_probs[[fate]], AUCell_df[[reg]], method = "spearman")
cor_matrix[reg, fate]  <- res$estimate
pval_matrix[reg, fate] <- res$p.value
}
}
pval_adj <- apply(pval_matrix, 2, p.adjust, method = "BH")
fateM3_regulons <- tibble(
regulon     = rownames(cor_matrix),
correlation = cor_matrix[, "M3 lineage"],
p_adj       = pval_adj[, "M3 lineage"]
) %>% filter(p_adj < 0.05) %>% arrange(desc(abs(correlation)))
fateM27_regulons <- tibble(
regulon     = rownames(cor_matrix),
correlation = cor_matrix[, "M27 lineage"],
p_adj       = pval_adj[, "M27 lineage"]
) %>% filter(p_adj < 0.05) %>% arrange(desc(abs(correlation)))
# ── Heatmap of top regulons per lineage (unchanged figure) ---------------------
top_regs <- unique(c(
fateM3_regulons$regulon[1:20],
fateM27_regulons$regulon[1:20]
))
heatmap_mat <- cor_matrix[top_regs, ]
pheatmap(
t(heatmap_mat),
color = viridis(100),
cluster_rows = FALSE,
cluster_cols = TRUE,
border_color = NA,
main = "Correlation between regulon activity and fate probabilities"
)
Guniverse   <- decoupleR::get_collectri(organism = "human", split_complexes = FALSE)
TF_universe <- Guniverse[Guniverse$source %in% regulon_df$regulon, ]
source("config.R")
source("functions.R")
library(Seurat)
library(tidyverse)
library(ape)
library(phytools)
library(ggplot2)
library(RColorBrewer)
library(ggrepel)
library(cluster)
library(copykat)
# Local overrides (this stage uses its own output dir, kept separate from the
# other stages' RESULTS_DIR/PLOTS_DIR since Fig 4 outputs are self-contained)
OUT_DIR <- PHYLO_OUT_DIR
N_HVG    <- 2000
N_PCS    <- 20
K_RANGE  <- 2:8
K_CLONES <- 3   # revisit after Section 2 diagnostics
