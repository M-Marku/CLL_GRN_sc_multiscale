D_values   <- extract_timepoint(cell_names)
annotation_col <- data.frame(TimePoint = D_values)
rownames(annotation_col) <- cell_names
ann_colors <- list(TimePoint = TIMEPOINT_COLORS)
# ── Top-variance TF filtering -------------------------------------
top_n       <- 100
