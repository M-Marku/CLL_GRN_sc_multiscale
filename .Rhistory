facet_wrap(~ node, nrow = 1, scales = "free_y", drop = FALSE) +
scale_fill_manual(values = TP_COLORS) +
labs(x = NULL, y = ylab) +
theme_classic(base_size = 10) +
theme(legend.position = "none", strip.background = element_blank(),
strip.text = element_text(face = "bold"))
}
