summarise_trend <- function(df, id, label) {
cat("\n=====", label, "=====\n")
cat("n =", nrow(df), "\n")
print(table(round(df$rho_AUCcum, 2), useNA = "ifany"))                       # distinct rho values
cat(sprintf("rho = +1: %d (%.1f%%) | rho = -1: %d (%.1f%%)\n",
sum(df$rho_AUCcum >= 0.9, na.rm = TRUE), 100 * mean(df$rho_AUCcum >= 0.9, na.rm = TRUE),
sum(df$rho_AUCcum <= -0.9, na.rm = TRUE), 100 * mean(df$rho_AUCcum <= -0.9, na.rm = TRUE)))
cat("\nTop 15 by |rho| (ties broken by total change):\n")
print(df %>% arrange(desc(abs(rho_AUCcum)), desc(total_change)) %>%
select(all_of(id), rho_AUCcum, delta_M3, delta_M27, total_change) %>% head(15))
}
